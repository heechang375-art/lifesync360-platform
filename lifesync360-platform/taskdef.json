{
  "family": "lifesync-dev-21-lifesync-ecs-existing-vpc-v4-td",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::354493396671:role/lifesync-dev-EcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::354493396671:role/lifesync-dev-EcsTaskRole",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<IMAGE1_NAME>",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AWS_REGION",    "value": "ap-northeast-2" },
        { "name": "DB_NAME",       "value": "lifesync360" },
        { "name": "DYNAMO_TABLE",  "value": "lifesync_customer_result" },
        { "name": "REDIS_PORT",    "value": "6379" },
        { "name": "USE_MOCK",              "value": "false" },
        { "name": "PROFILE_SYNC_LAMBDA",  "value": "customer-profile-sync" },
        { "name": "ONPREM_QUERY_LAMBDA",  "value": "lifesync-onprem-customer-query" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:ecs-jwt-signing-hDXOQc:jwt::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master-S8ZoCX:DB_USER::"
        },
        {
          "name": "DB_PASS",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master-S8ZoCX:DB_PASS::"
        },
        {
          "name": "AURORA_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master-S8ZoCX:AURORA_HOST::"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master-S8ZoCX:REDIS_HOST::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lifesync-platform",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
