{
    "family": "lifesync-dev-21-lifesync-ecs-existing-vpc-v4-td",
    "taskRoleArn": "arn:aws:iam::354493396671:role/lifesync-dev-EcsTaskRole",
    "executionRoleArn": "arn:aws:iam::354493396671:role/lifesync-dev-EcsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "354493396671.dkr.ecr.ap-northeast-2.amazonaws.com/lifesync-dev-lifesync-service:b78b3a30",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PROFILE_SYNC_LAMBDA",
                    "value": "customer-profile-sync"
                },
                {
                    "name": "AWS_REGION",
                    "value": "ap-northeast-2"
                },
                {
                    "name": "DB_NAME",
                    "value": "lifesync360"
                },
                {
                    "name": "USE_MOCK",
                    "value": "false"
                },
                {
                    "name": "DYNAMO_TABLE",
                    "value": "lifesync_customer_result"
                },
                {
                    "name": "ONPREM_QUERY_LAMBDA",
                    "value": "lifesync-onprem-customer-query"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:ecs-jwt-signing:jwt::"
                },
                {
                    "name": "REDIS_HOST",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:lifesync/dev/redis:host::"
                },
                {
                    "name": "REDIS_PORT",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:lifesync/dev/redis:port::"
                },
                {
                    "name": "DB_USER",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master:username::"
                },
                {
                    "name": "DB_PASS",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master:password::"
                },
                {
                    "name": "AURORA_HOST",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:354493396671:secret:/lifesync/dev/db/master:host::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/lifesync-platform",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024"
}
